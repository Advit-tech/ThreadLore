# =====================================================================
# ThreadLore - Environment Variables Configuration
# Copy this file to .env and customize for your local setup.
# =====================================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# SQLite Database Location (defaults to backend/data/chat_vault.db)
DATABASE_PATH=backend/data/chat_vault.db

# DiscordChatExporter CLI Binary Location
# If blank, ThreadLore looks in backend/bin/ and system PATH
DISCORD_EXPORTER_PATH=backend/bin/DiscordChatExporter.Cli.bat

# LLM Inference Endpoint (OpenAI-compatible)
# Target: Nous Research Hermes 3 via Ollama (http://localhost:11434/v1), LM Studio (http://localhost:1234/v1), or vLLM
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=hermes3
LLM_API_KEY=ollama

# ElevenLabs Expressive Voice Integration
# Leave empty to use automatic browser Web Speech Synthesis fallback
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
